{
  "name": "neorc-ui",
  "private": true,
  "version": "0.0.0",
  "description": "The neorc manager's web UI; built into the neorc-ui Python distribution",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "typecheck": "npm run generate && tsc -b",
    "lint": "npm run generate && eslint .",
    "test": "npm run generate && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@tanstack/react-query": "5.105.0",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-license": "3.7.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
