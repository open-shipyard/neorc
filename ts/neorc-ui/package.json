{
  "name": "@neorc/ui",
  "version": "0.0.0",
  "private": true,
  "description": "neorc's interface: a root component for oneberth's shell, and standalone neorc, built into the neorc-ui Python distribution",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./app": "./src/NeorcApp.tsx"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test",
    "!src/standalone",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build && node scripts/check-package.mjs",
    "typecheck": "npm run generate && tsc -b",
    "lint": "npm run generate && eslint .",
    "test": "npm run generate && vitest run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@oneberth/ui": "0.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@tanstack/react-query": "5.107.1",
    "@xyflow/react": "12.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oneberth/ui": "file:vendor/oneberth-ui-0.0.0.tgz",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup-plugin-license": "3.7.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
