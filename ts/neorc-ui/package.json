{
  "name": "neorc-ui",
  "private": true,
  "version": "0.0.0",
  "description": "The neorc manager's web UI; built into the neorc-ui Python distribution",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "typecheck": "npm run generate && tsc -b",
    "lint": "npm run generate && eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.0.8",
    "react-dom": "19.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-license": "3.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
